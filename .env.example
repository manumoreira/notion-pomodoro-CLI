# Notion API Integration Token (Secret internal integration token starting with 'secret_' or 'ntn_')
NOTION_API_KEY=secret_your_notion_api_key_here

# Notion Database ID (32-character ID from your database URL)
NOTION_DATABASE_ID=your_32_character_database_id_here

# Optional Default Timer Settings (in minutes)
POMODORO_WORK_MINUTES=25
POMODORO_SHORT_BREAK_MINUTES=5
POMODORO_LONG_BREAK_MINUTES=15
POMODORO_CYCLES=4
